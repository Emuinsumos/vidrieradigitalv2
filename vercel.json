{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "delmana": {
      "root": "demos-src/delmana",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/delmana/(.*)",
      "destination": {
        "service": "delmana"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
